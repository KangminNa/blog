# 러너 설정. 복사해서 .env로 쓰세요: cp apps/runner/.env.example apps/runner/.env
# 토큰이 셸 기록에 남지 않게 여기에 둔다 (.env는 git에 올라가지 않아요)

# 블로그 주소 (<주소>/mcp로 붙는다)
CAIRN_RUNNER_URL=

# 기기 토큰: 콘솔의 기기 메뉴 → 러너 추가
CAIRN_RUNNER_TOKEN=

# 동시에 하는 일의 수 (1~8). 이 컴퓨터의 러너는 기본 1. 늘리면 AI CLI가 그만큼 함께 돌고 구독 사용량이 빨리 찬다
# CAIRN_RUNNER_CONCURRENCY=1

# Claude 토큰: claude setup-token으로 만든다
# 적으면 이 값이 우선한다. 비워 두면 콘솔의 AI 메뉴에 넣은(또는 웹에서 로그인한) 토큰을 일마다 서버에서 받는다
CLAUDE_CODE_OAUTH_TOKEN=

# AI CLI 경로. 기본은 PATH의 claude
# 데스크톱 앱만 깔린 Mac은 PATH에 없어서 전체 경로를 적는다
# CAIRN_RUNNER_CLI=

# Codex CLI 경로. 기본은 PATH의 codex. 콘솔 AI 메뉴의 웹 로그인과 Codex 에이전트의 일에 쓴다
# CAIRN_RUNNER_CODEX_CLI=

# 스킬 폴더. 기본은 저장소의 skills/
# CAIRN_SKILLS_DIR=

# 브라우저 탭 읽기(browser-tabs 패키지): 로그인된 브라우저의 CDP 주소. 비워 두면 탭을 읽지 않는다
# Chrome을 이 러너 전용 프로필로 띄우고, 그 창에서 읽을 사이트에 로그인해 둔다:
#   google-chrome --remote-debugging-port=9222 --user-data-dir="$HOME/.cairn-browser"
# 이 주소는 그 브라우저를 마음대로 움직일 수 있다. 127.0.0.1에서만 열고, 평소 쓰는 프로필로 띄우지 않는다
# 러너는 새 탭을 열어 제목과 보이는 글자만 읽고 닫는다 (클릭 · 입력 없음). 로그에는 주소의 호스트만 남긴다
# 서버 러너(연결 값 파일)에서는 브라우저 작업(browse: AI가 Playwright MCP로 브라우저를 움직임)도 받는다. 내 컴퓨터 러너는 탭 읽기만
# CAIRN_BROWSER_URL=http://127.0.0.1:9222

# 이 러너에 묶인 에이전트에게 나눠 줄 폴더 (선택, 쉼표로 여럿, 절대 경로). 내 컴퓨터 러너만 (코드 러너 칸은 안 됨)
# 콘솔의 에이전트 편집에서 "실행 러너"를 이 러너로 정한 에이전트의 일에만 연다. 다른 에이전트는 이 폴더를 보지 않는다
# 원본을 열지 않고 일마다 작업 폴더(folders/<이름>)로 복사한다: AI가 고쳐도 원본에 닿지 않는다 (읽기만)
# 숨김 파일 · .git · node_modules · 링크는 빼고, 한 번에 50MB · 5,000개까지. 홈 폴더 전체와 숨김 폴더는 받지 않는다
# AI가 답에 옮겨 적은 내용은 서버(내 블로그)로 간다
# CAIRN_RUNNER_FOLDERS=/Users/me/projects/contest,/Users/me/Documents/notes
