{
  "name": "@cairn/web",
  "version": "0.0.0",
  "private": true,
  "description": "Cairn 웹 (Next.js): 그래프, 블로그, 관리 모드",
  "scripts": {
    "dev": "node ../../scripts/sync-plugins.mjs && next dev -H 0.0.0.0 -p 3000",
    "build": "node ../../scripts/sync-plugins.mjs && next build",
    "start": "next start -p 3000",
    "typecheck": "node ../../scripts/sync-plugins.mjs && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
