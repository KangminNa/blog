{
  "name": "@cairn/server",
  "version": "0.0.0",
  "private": true,
  "description": "Cairn 서버 (NestJS). 진입점: api, worker(일꾼), cli(pnpm plugin · install-code)",
  "scripts": {
    "dev": "node --watch -r @swc-node/register src/main.api.ts",
    "build": "tsc",
    "start:api": "node dist/main.api.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../../plugins/tsconfig.json",
    "test": "node --test --test-concurrency=1 -r @swc-node/register \"src/**/*.test.ts\" \"../../plugins/*/server/**/*.test.ts\"",
    "worker": "node --watch -r @swc-node/register src/main.worker.ts",
    "cli": "node -r @swc-node/register src/main.cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "postgres": "3.4.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.13",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
