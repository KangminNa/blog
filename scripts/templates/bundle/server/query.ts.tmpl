import { Injectable } from '@nestjs/common';
//#if tool
import { Actor, BaseQuery } from '../../platform';
//#else
import { type Actor, BaseQuery } from '../../platform';
//#endif
import { __tables__ } from '../__module__.schema';
//#if tool
import { __Name__ListView, __Name__View, Tool__Name__View } from './__bundle__.view';
//#else
import { __Name__ListView, __Name__View } from './__bundle__.view';
//#endif

// __label__ 읽기. 공개 메서드는 Actor를 받고 첫 줄에서 권한을 묻는다. 행을 View에 그대로 넘긴다.
// 표 하나의 읽기는 코어의 조건 규칙(this.rows · row · exists)으로 (객체설계 6장). 표를 잇거나 모으면 this.sql로 쓴다.
// 공개 범위가 있는 데이터면 SQL에서 거른 뒤 개수·순위를 계산한다.
@Injectable()
export class __Name__Query extends BaseQuery {
  /** 콘솔의 __label__ 메뉴 (주인만). 공간의 __label__ 전부, 최근 것부터 */
  async list(actor: Actor): Promise<__Name__ListView> {
    actor.assertOwner();
    const rows = await this.rows(__tables__, { space_id: actor.requireSpace() }, { order: ['id desc'] });
    return new __Name__ListView(rows.map((r) => new __Name__View(r)));
  }
//#if tool

  /** AI 도구 (__tool__). 공간의 __label__ 전부, 최근 것부터 */
  async forTool(actor: Actor): Promise<Tool__Name__View> {
    actor.assertCan(Actor.READ_ALL);
    return new Tool__Name__View(
      await this.rows(__tables__, { space_id: actor.requireSpace() }, { order: ['id desc'] }),
    );
  }
//#endif
}
