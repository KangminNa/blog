import { Injectable } from '@nestjs/common';
//#if tool
import { Actor, BaseQuery, desc, eq, QueryTemplate } from '../../platform';
//#else
import { type Actor, BaseQuery, desc, eq, QueryTemplate } from '../../platform';
//#endif
import { __tables__ } from '../__module__.schema';
import type { __Table__Row } from '../__module__.tables';
//#if tool
import { __Name__ListView, __Name__View, Tool__Name__View } from './__bundle__.view';
//#else
import { __Name__ListView, __Name__View } from './__bundle__.view';
//#endif

// __label__ 읽기. 공개 메서드는 Actor를 받고 첫 줄에서 권한을 묻는다. 행을 View에 그대로 넘긴다.
// 표 하나의 읽기는 미리 만든 쿼리 템플릿으로 (객체설계 6장). 표를 잇거나 모으면 this.sql로 쓴다.
// 공개 범위가 있는 데이터면 SQL에서 거른 뒤 개수·순위를 계산한다.
@Injectable()
export class __Name__Query extends BaseQuery {
  /** 공간의 __label__ 전부, 최근 것부터 */
  private static readonly ALL = QueryTemplate.of<{ space: string }, __Table__Row>((q) =>
    q
      .select()
      .from(__tables__)
      .where(eq(__tables__.space_id, QueryTemplate.value('space')))
      .orderBy(desc(__tables__.id)),
  );

  /** 콘솔의 __label__ 메뉴 (주인만) */
  async list(actor: Actor): Promise<__Name__ListView> {
    actor.assertOwner();
    const rows = await __Name__Query.ALL.rows(this.sql, { space: actor.requireSpace() });
    return new __Name__ListView(rows.map((r) => new __Name__View(r)));
  }
//#if tool

  /** AI 도구 (__tool__) */
  async forTool(actor: Actor): Promise<Tool__Name__View> {
    actor.assertCan(Actor.READ_ALL);
    return new Tool__Name__View(await __Name__Query.ALL.rows(this.sql, { space: actor.requireSpace() }));
  }
//#endif
}
