import { Body, Controller, Get, Param, Patch, Post } from '@nestjs/common';
import { type Actor, CurrentActor } from '../../platform';
import { Create__Name__Input, Update__Name__Input } from './__bundle__.input';
import { __Name__Query } from './__bundle__.query';
import { __Name__Service } from './__bundle__.service';
import type { __Name__ListView, __Name__View } from './__bundle__.view';

// __label__ API. Input 만들기 → Service·Query 메서드 하나 → View. 권한은 Service·Query 첫 줄에서.
// 만들거나 고친 뒤에는 하나를 돌려주고, 화면은 그 version으로 다음 변경을 보낸다.
@Controller('api/__plural__')
export class __Name__Controller {
  constructor(
    private readonly query: __Name__Query,
    private readonly service: __Name__Service,
  ) {}

  @Get()
  list(@CurrentActor() actor: Actor): Promise<__Name__ListView> {
    return this.query.list(actor);
  }

  @Post()
  async create(@CurrentActor() actor: Actor, @Body() body: unknown): Promise<__Name__View> {
    return (await this.service.create(actor, Create__Name__Input.from(body))).view();
  }

  @Patch(':id')
  async update(
    @CurrentActor() actor: Actor,
    @Param('id') id: string,
    @Body() body: unknown,
  ): Promise<__Name__View> {
    return (await this.service.update(actor, Update__Name__Input.from(id, body))).view();
  }
}
