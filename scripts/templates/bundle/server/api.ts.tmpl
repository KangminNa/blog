import { Body, Controller, Get, Param, Patch, Post } from '@nestjs/common';
import { type Actor, BaseResponse, CurrentActor } from '../../platform';
import type { __Name__ } from './__bundle__';
import { __Name__IdInput, Create__Name__Input, Update__Name__Input } from './__bundle__.input';
import { __Name__Query } from './__bundle__.query';
import { __Name__Service } from './__bundle__.service';
import { type __Name__ListView, __Name__View } from './__bundle__.view';

/** __label__ 목록 */
export class __Name__ListResponse extends BaseResponse {
  private constructor(private readonly view: __Name__ListView) {
    super();
  }

  static of(view: __Name__ListView): __Name__ListResponse {
    return new __Name__ListResponse(view);
  }

  toJSON(): object {
    return this.view.toJSON();
  }
}

/** 만들거나 고친 __label__ 하나. 화면은 이 version으로 다음 변경을 보낸다 */
export class __Name__Response extends BaseResponse {
  private constructor(private readonly item: __Name__) {
    super();
  }

  static of(item: __Name__): __Name__Response {
    return new __Name__Response(item);
  }

  toJSON(): object {
    const i = this.item;
    return new __Name__View(i.id, i.name, i.createdAt, i.version).toJSON();
  }
}

// __label__ API. Request 만들기 → Service·Query 메서드 하나 → Response. 권한은 Service·Query 첫 줄에서.
@Controller('api/__plural__')
export class __Name__Controller {
  constructor(
    private readonly query: __Name__Query,
    private readonly service: __Name__Service,
  ) {}

  @Get()
  async list(@CurrentActor() actor: Actor): Promise<__Name__ListResponse> {
    return __Name__ListResponse.of(await this.query.list(actor));
  }

  @Post()
  async create(@CurrentActor() actor: Actor, @Body() body: unknown): Promise<__Name__Response> {
    return __Name__Response.of(await this.service.create(actor, Create__Name__Input.from(body)));
  }

  @Patch(':id')
  async update(
    @CurrentActor() actor: Actor,
    @Param('id') id: string,
    @Body() body: unknown,
  ): Promise<__Name__Response> {
    const target = __Name__IdInput.from(id);
    return __Name__Response.of(
      await this.service.update(actor, target.id, Update__Name__Input.from(body)),
    );
  }
}
