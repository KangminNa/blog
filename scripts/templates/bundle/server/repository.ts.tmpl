import { BaseRepository, type Row } from '../../platform';
import { __Name__ } from './__bundle__';

// __schema__.__table__ ↔ __Name__. 바뀐 칸만 저장하고 version으로 늦은 쓰기를 막는다.
export class __Name__Repository extends BaseRepository<__Name__> {
  protected toEntity(row: Row): __Name__ {
    return __Name__.restore(
      String(row.id),
      Number(row.version),
      String(row.space_id),
      String(row.name),
      new Date(row.created_at),
    );
  }

  /** 고칠 것을 잠근다. 없으면 NotFound */
  async lock(spaceId: string, id: string): Promise<__Name__> {
    const rows = await this.sql`
      SELECT * FROM __schema__.__table__ WHERE id = ${id} AND space_id = ${spaceId} FOR UPDATE`;
    return this.one(rows, '__label__');
  }

  async save(item: __Name__): Promise<void> {
    if (item.isNew) {
      await this.sql`
        INSERT INTO __schema__.__table__ (id, space_id, name, created_at)
        VALUES (${item.id}, ${item.spaceId}, ${item.name}, ${item.createdAt})`;
    } else if (item.changed) {
      const result = await this.sql`
        UPDATE __schema__.__table__ SET ${this.sql(item.changes)}, version = version + 1
        WHERE id = ${item.id} AND version = ${item.version}`;
      this.expectUpdated(result.count, item);
    }
    item.clearChanges();
    await this.publishEvents(item);
  }
}
