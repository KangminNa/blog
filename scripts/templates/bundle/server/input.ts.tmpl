import { BaseRequest, type ColumnReaders } from '../../platform';
import type { __Table__Row } from '../__module__.tables';
import { __Name__ } from './__bundle__';

// __label__ 입력의 모양. 뜻(빈 이름 등)은 __Name__의 RULES가 검사한다.

/** 주인이 정하는 칸. 칸 하나에 한 줄이다. 보내지 않은 칸은 그대로 */
const COLUMNS: ColumnReaders<__Table__Row> = {
  name: (f, n) => f.optionalText(n, __Name__.NAME_MAX) ?? undefined,
};

/** POST /api/__plural__. 같은 requestId는 처음 만든 것을 돌려준다 */
export class Create__Name__Input extends BaseRequest {
  private constructor(
    readonly requestId: string,
    readonly fields: Partial<__Table__Row>,
  ) {
    super();
  }

  /** 이름은 꼭 있어야 한다. 먼저 읽어 틀린 칸이 칸 순서대로 모인다 */
  static from(raw: unknown): Create__Name__Input {
    return BaseRequest.read(
      raw,
      (f) =>
        new Create__Name__Input(f.uuid('requestId'), {
          name: f.text('name', __Name__.NAME_MAX),
          ...f.columns(COLUMNS),
        }),
    );
  }
}

/** PATCH /api/__plural__/:id. 본 version을 함께 보낸다 (낙관적 잠금) */
export class Update__Name__Input extends BaseRequest {
  private constructor(
    readonly id: string,
    readonly version: number,
    readonly changes: Partial<__Table__Row>,
  ) {
    super();
  }

  static from(id: string, raw: unknown): Update__Name__Input {
    return BaseRequest.read(
      { ...(raw as object), id },
      (f) => new Update__Name__Input(f.uuid('id'), f.version(), f.columns(COLUMNS)),
    );
  }
}
