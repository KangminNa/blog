import { Injectable } from '@nestjs/common';
import { Actor, BaseResponse, BaseTool } from '../../platform';
import { __Name__Query } from './__bundle__.query';
import type { __Name__ListView } from './__bundle__.view';

/** __tool__의 답. MCP는 snake_case */
export class Tool__Name__Response extends BaseResponse {
  private constructor(private readonly view: __Name__ListView) {
    super();
  }

  static of(view: __Name__ListView): Tool__Name__Response {
    return new Tool__Name__Response(view);
  }

  toJSON(): object {
    return {
      items: this.view.items.map((i) => ({
        id: i.id,
        name: i.name,
        created_at: i.createdAt.toISOString(),
      })),
    };
  }
}

// AI 도구가 읽는 __label__. 비공개면 read_all로만 연다. 입력 모양을 바꾸면 쓰는 스킬도 함께 고친다 (AGENTS.md).
@Injectable()
export class List__Name__Tool extends BaseTool {
  readonly name = '__tool__';
  readonly scope = Actor.READ_ALL;
  readonly readOnly = true;
  readonly description = '__label__ 목록을 읽는다. 언제 이 도구를 쓸지 AI가 판단할 수 있게 적는다.';
  readonly inputSchema = { properties: {} };

  constructor(private readonly query: __Name__Query) {
    super();
  }

  async handle(actor: Actor): Promise<Tool__Name__Response> {
    return Tool__Name__Response.of(await this.query.forTool(actor));
  }
}
