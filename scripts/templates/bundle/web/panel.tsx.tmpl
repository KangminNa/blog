'use client';

import { type FormEvent, useCallback, useEffect, useRef, useState } from 'react';
import type {
  __Name__ListView,
  __Name__View,
} from '__server_rel__/__module__/__bundle__/__bundle__.view';
import { api, describe } from '../../_lib/client-api';
import { useNotify } from '../AdminShell';

// 응답 모양은 서버 view의 toJSON()이 원본이다. 웹에서 손으로 적지 않는다 (객체설계 6장).
// 다른 메뉴도 쓰면 app/_<모듈>/types.ts로 옮겨 함께 쓴다.
type Item = ReturnType<__Name__View['toJSON']>;
type List = ReturnType<__Name__ListView['toJSON']>;

// __label__: 이 메뉴가 하는 일을 한 줄로 적는다.
export function __Name__Panel() {
  const notify = useNotify();
  const [items, setItems] = useState<Item[] | null>(null);
  const [name, setName] = useState('');
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);
  /** 응답을 못 받아 다시 눌러도 하나만 만들어지게, 만든 뒤에만 새 값으로 바꾼다 */
  const requestId = useRef('');
  if (!requestId.current) requestId.current = crypto.randomUUID();

  const load = useCallback(async () => {
    const reply = await api<List>('GET', '/api/__plural__');
    if (!reply.ok) return setError(describe(reply.error));
    setItems(reply.data.items);
  }, []);

  useEffect(() => {
    void load();
  }, [load]);

  async function add(e: FormEvent) {
    e.preventDefault();
    setBusy(true);
    setError(null);
    const reply = await api<Item>('POST', '/api/__plural__', {
      requestId: requestId.current,
      name: name.trim(),
    });
    setBusy(false);
    if (!reply.ok) return setError(describe(reply.error));
    requestId.current = crypto.randomUUID();
    setName('');
    setItems((before) => [reply.data, ...(before ?? [])]);
    notify('추가했어요');
  }

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
      <form onSubmit={add}>
        <label className="field">
          <span>이름</span>
          <input
            className="input"
            value={name}
            required
            maxLength={100}
            onChange={(e) => setName(e.target.value)}
          />
        </label>
        {error && (
          <p className="error" role="alert">
            {error}
          </p>
        )}
        <button type="submit" className="cta small" disabled={busy}>
          {busy ? '추가 중' : '추가'}
        </button>
      </form>

      {items === null ? (
        !error && <p className="label-mono">불러오는 중…</p>
      ) : items.length === 0 ? (
        <p className="label-mono">__label__ 없음</p>
      ) : (
        <ul className="list" aria-label="__label__ 목록">
          {items.map((item) => (
            <li key={item.id}>
              <b>{item.name}</b>
            </li>
          ))}
        </ul>
      )}
    </div>
  );
}
