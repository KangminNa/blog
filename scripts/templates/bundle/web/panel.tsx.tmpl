'use client';

import { type FormEvent, useRef, useState } from 'react';
import type {
  __Name__ListView,
  __Name__View,
} from '__server_rel__/__module__/__bundle__/__bundle__.view';
import { api } from '../../_lib/client-api';
import { useAction } from '../../_lib/use-action';
import { useLiveValue } from '../../_lib/use-live';

// 응답 모양은 서버 view의 toJSON()이 원본이다. 웹에서 손으로 적지 않는다 (.claude/rules/web.md).
// 다른 메뉴도 쓰면 app/_<모듈>/types.ts로 옮겨 함께 쓴다.
type Item = ReturnType<__Name__View['toJSON']>;
type List = ReturnType<__Name__ListView['toJSON']>;

// __label__: 이 메뉴가 하는 일을 한 줄로 적는다.
// 패턴 "목록 + 만들기 폼": 읽기는 useLiveValue(신호가 오면 다시 읽는다), 쓰기는 useAction(바쁨 · 오류 · 알림 · 다시 읽기).
export function __Name__Panel() {
  // 서버가 이 묶음의 변경 신호를 보내면 주제를 적는다 (예: ['__module__.__bundle__.*']). 없으면 처음과 다시 연결될 때만 읽는다
  const list = useLiveValue('__plural__', () => api<List>('GET', '/api/__plural__'), []);
  const action = useAction();
  const [name, setName] = useState('');
  /** 응답을 못 받아 다시 눌러도 하나만 만들어지게, 만든 뒤에만 새 값으로 바꾼다 */
  const requestId = useRef('');
  if (!requestId.current) requestId.current = crypto.randomUUID();
  const items = list.data?.items ?? null;
  const error = action.problem ?? list.error;
  const busy = action.busy !== null;

  async function add(e: FormEvent) {
    e.preventDefault();
    const reply = await action.run(
      'add',
      () => api<Item>('POST', '/api/__plural__', { requestId: requestId.current, name: name.trim() }),
      { done: '추가했어요', reload: list.reload },
    );
    if (!reply?.ok) return;
    requestId.current = crypto.randomUUID();
    setName('');
  }

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
      <form onSubmit={add}>
        <label className="field">
          <span>이름</span>
          <input
            className="input"
            value={name}
            required
            maxLength={100}
            onChange={(e) => setName(e.target.value)}
          />
        </label>
        {error && (
          <p className="error" role="alert">
            {error}
          </p>
        )}
        <button type="submit" className="cta small" disabled={busy}>
          {busy ? '추가 중' : '추가'}
        </button>
      </form>

      {items === null ? (
        !error && <p className="label-mono">불러오는 중…</p>
      ) : items.length === 0 ? (
        <p className="label-mono">__label__ 없음</p>
      ) : (
        <ul className="list" aria-label="__label__ 목록">
          {items.map((item) => (
            <li key={item.id}>
              <b>{item.name}</b>
            </li>
          ))}
        </ul>
      )}
    </div>
  );
}
