# 개발 환경 설정. 복사해서 .env로 쓰세요: cp .env.example .env

# DB
DB_PASSWORD=cairn
DB_PORT=5432

# 서버(API)와 웹 포트
SERVER_PORT=4000
WEB_PORT=3000

# 서버 키: 비밀값(플러그인 토큰 등)을 DB에 암호화해 넣을 때 쓴다. 설치 때 한 번 만들고 바꾸지 않는다
#   만들기: pnpm secret:new
#   잃어버리면 저장된 비밀값을 다시 넣어야 해요
CAIRN_SECRET_KEY=

# 플러그인은 여기서 설정하지 않아요. 켜기·설정은 설치 마법사·관리 화면에서 (화면 전에는 pnpm plugin)
