# Cairn 설정. 복사해서 .env로 쓰세요: cp .env.example .env
# 블로그 이름·사이트 주소·플러그인은 여기가 아니라 설치 마법사·관리 화면에서 정해요

# 서버에 올릴 때는 운영 compose를 쓴다 (컴파일한 이미지, root가 아닌 사용자, 소스 마운트 없음)
#   docker-compose.override.yml을 쓰는 서버는 COMPOSE_FILE=docker-compose.prod.yml:docker-compose.override.yml
# COMPOSE_FILE=docker-compose.prod.yml
# 파일 여럿을 :로 잇는다. Windows는 기본 구분자가 ;라서 아래 줄이 있어야 :가 먹는다 (Linux · Mac에서도 그대로 둬도 된다)
COMPOSE_PATH_SEPARATOR=:

# DB 비밀번호. 서버에 올릴 때는 긴 임의 값으로 (DB를 처음 만들 때 정해져서 나중에 바꾸면 맞지 않아요)
DB_PASSWORD=cairn
DB_PORT=5432

# 서버(API)와 웹 포트. DB · 서버 · 웹 모두 이 컴퓨터(127.0.0.1)에서만 열린다 (밖에는 https 프록시만)
SERVER_PORT=4000
WEB_PORT=3000

# 서버 키: 비밀값(플러그인 토큰 등)을 DB에 암호화해 넣을 때 쓴다. 설치 때 한 번 만든다
#   만들기: pnpm secret:new  (node가 없으면 openssl rand -base64 32)
#   잃어버리면 저장된 비밀값을 다시 넣어야 해요
CAIRN_SECRET_KEY=

# 서버 키를 바꿀 때만 쓴다. 순서:
#   1. 지금 키를 CAIRN_SECRET_KEY_OLD로 옮기고, CAIRN_SECRET_KEY에 새 키를 넣는다
#   2. docker compose up -d   (서버·일꾼이 새 키로 쓰고, 옛 키로 잠긴 값도 읽는다)
#   3. pnpm secret:rotate     (node가 없으면 docker compose exec -T server cairn-admin secret rotate)
#      저장된 비밀값을 새 키로 다시 암호화한다. 두 번 돌려도 안전하고, 풀리지 않는 값이 있으면 멈춘다
#   4. CAIRN_SECRET_KEY_OLD를 지우고 docker compose up -d
#   키를 바꾸면 설치 코드가 바뀌고, 진행 중인 기기 승인·설치·외부 로그인은 처음부터 다시 해야 해요
# CAIRN_SECRET_KEY_OLD=

# 사람이 여는 웹 주소. 서버에 올렸으면 꼭 https://내블로그주소
#   설치 코드 안내에 쓰고, 개발 모드 웹이 이 주소에서 열린 화면만 동작하게 한다 (없으면 버튼이 눌리지 않아요)
# CAIRN_WEB_URL=

# 브라우저 푸시: 따로 할 일 없음. 서버 키에서 VAPID 키를 만들고, 알려진 푸시 서비스(크롬 · 파이어폭스 · 사파리 · 엣지)로만 보낸다
#   서버 키를 바꾸면 콘솔의 알림 메뉴에서 브라우저마다 "다시 켜기"를 눌러야 해요
#   직접 운영하는 푸시 서비스가 있을 때만 그 출처를 쉼표로: CAIRN_PUSH_EXTRA_ORIGINS=https://push.example.com

# 서버 러너: 에이전트의 일을 이 서버의 컨테이너에서 돌린다. 서버와 함께 뜨고 스스로 연결한다 (여기서 할 일 없음)
#   콘솔의 AI 메뉴에 claude setup-token의 토큰을 넣고 연결 확인을 누르면 일한다
#   예전처럼 기기 토큰을 직접 줄 때만: CAIRN_RUNNER_TOKEN=
# 내 컴퓨터에서 러너를 돌리는 법은 apps/runner/.env.example

# 플러그인은 여기서 설정하지 않아요. 켜기·설정은 설치 마법사·관리 화면에서 (화면 전에는 pnpm plugin)

# 브라우저 에이전트 (선택, README 6). 켜려면 COMPOSE_FILE에 docker-compose.browser.yml을 더한다
#   COMPOSE_FILE=docker-compose.prod.yml:docker-compose.browser.yml
# 내 컴퓨터(개발)에서 켤 때: COMPOSE_FILE=docker-compose.yml:docker-compose.browser.yml, CAIRN_PUBLIC_IP=127.0.0.1
#   화면은 콘솔이 아니라 새 탭의 http://localhost:4100 에서 본다 (콘솔의 /browser/는 앞단 프록시가 있는 배포 서버에서만 열린다)
# 서버 브라우저 화면에 들어갈 때 묻는 비밀번호 (Caddy의 주인 확인과 두 겹)
# CAIRN_BROWSER_PASSWORD=
# 화면 영상(UDP 52000)이 밖에서 닿을 서버의 공인 IP
# CAIRN_PUBLIC_IP=
# 화면 페이지 포트 (이 서버 안에서만, Caddy가 /browser/로 넘긴다)
# BROWSER_VIEW_PORT=4100

# 결과물(AI가 작업에서 만든 파일)의 한도. 공간 전체 GB, 디스크에 늘 남길 GB (DB가 디스크가 차서 멈추지 않게)
#   기본은 80 · 20 (디스크 200GB 기준). 모자라면 늘리거나, 나중에 클라우드 저장소로 옮긴다
# CAIRN_OUTPUTS_MAX_GB=80
# CAIRN_DISK_RESERVE_GB=20
