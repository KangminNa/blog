# Cairn 설정. 복사해서 .env로 쓰세요: cp .env.example .env
# 블로그 이름·사이트 주소·플러그인은 여기가 아니라 설치 마법사·관리 화면에서 정해요

# 서버에 올릴 때는 운영 compose를 쓴다 (컴파일한 이미지, root가 아닌 사용자, 소스 마운트 없음)
#   docker-compose.override.yml을 쓰는 서버는 COMPOSE_FILE=docker-compose.prod.yml:docker-compose.override.yml
# COMPOSE_FILE=docker-compose.prod.yml

# DB 비밀번호. 서버에 올릴 때는 긴 임의 값으로 (DB를 처음 만들 때 정해져서 나중에 바꾸면 맞지 않아요)
DB_PASSWORD=cairn
DB_PORT=5432

# 서버(API)와 웹 포트. DB · 서버 · 웹 모두 이 컴퓨터(127.0.0.1)에서만 열린다 (밖에는 https 프록시만)
SERVER_PORT=4000
WEB_PORT=3000

# 서버 키: 비밀값(플러그인 토큰 등)을 DB에 암호화해 넣을 때 쓴다. 설치 때 한 번 만든다
#   만들기: pnpm secret:new  (node가 없으면 openssl rand -base64 32)
#   잃어버리면 저장된 비밀값을 다시 넣어야 해요
CAIRN_SECRET_KEY=

# 서버 키를 바꿀 때만 쓴다. 순서:
#   1. 지금 키를 CAIRN_SECRET_KEY_OLD로 옮기고, CAIRN_SECRET_KEY에 새 키를 넣는다
#   2. docker compose up -d   (서버·일꾼이 새 키로 쓰고, 옛 키로 잠긴 값도 읽는다)
#   3. pnpm secret:rotate     (node가 없으면 docker compose exec -T server cairn-admin secret rotate)
#      저장된 비밀값을 새 키로 다시 암호화한다. 두 번 돌려도 안전하고, 풀리지 않는 값이 있으면 멈춘다
#   4. CAIRN_SECRET_KEY_OLD를 지우고 docker compose up -d
#   키를 바꾸면 설치 코드가 바뀌고, 진행 중인 기기 승인·설치·외부 로그인은 처음부터 다시 해야 해요
# CAIRN_SECRET_KEY_OLD=

# 사람이 여는 웹 주소. 서버에 올렸으면 꼭 https://내블로그주소
#   설치 코드 안내에 쓰고, 개발 모드 웹이 이 주소에서 열린 화면만 동작하게 한다 (없으면 버튼이 눌리지 않아요)
# CAIRN_WEB_URL=

# 서버 러너: 에이전트의 일을 이 서버의 컨테이너에서 돌린다. 운영 compose의 runner 프로필일 때만 뜬다
#   1. 콘솔의 기기 메뉴 → 러너 추가로 받은 토큰을 CAIRN_RUNNER_TOKEN에 넣고, 아래 두 줄을 켠다
#   2. docker compose up -d --build
#   3. 콘솔의 AI 메뉴에 claude setup-token의 토큰을 넣고 연결 확인을 누른다
# COMPOSE_PROFILES=runner
# CAIRN_RUNNER_TOKEN=

# 플러그인은 여기서 설정하지 않아요. 켜기·설정은 설치 마법사·관리 화면에서 (화면 전에는 pnpm plugin)
