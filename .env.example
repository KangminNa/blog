# Cairn 설정. 복사해서 .env로 쓰세요: cp .env.example .env
# 블로그 이름 · 사이트 주소 · 플러그인 · AI 토큰은 여기가 아니라 설치 화면 · 콘솔에서 정해요
#
# ── 빠른 시작: 아래 넷 중 하나를 골라 그 묶음의 # 를 지우고 값을 채운다 ──────────────────────
#
# [A] 내 컴퓨터에서 개발 · 시험 (pnpm dev)
#     이 파일 그대로 두고 CAIRN_SECRET_KEY만 채우면 된다 (pnpm secret:new 결과)
#     브라우저까지 켜려면:
#       COMPOSE_FILE=docker-compose.yml:docker-compose.browser.yml
#       CAIRN_BROWSER_PASSWORD=아무거나-긴-비밀번호
#       CAIRN_PUBLIC_IP=127.0.0.1
#     화면은 콘솔이 아니라 새 탭의 http://localhost:4100 에서 본다 (콘솔의 화면 칸은 앞단 프록시가 있는 서버에서만 열린다)
#
# [B] 서버: 블로그 · 콘솔 · AI 연결만
#       COMPOSE_FILE=docker-compose.prod.yml
#       DB_PASSWORD=<긴 임의 값>
#       CAIRN_SECRET_KEY=<pnpm secret:new 또는 openssl rand -base64 32>
#       CAIRN_WEB_URL=https://내블로그주소
#
# [C] 서버: B + 페이지 · PPT · 문서 만들기 (만들기 일은 코드 러너 칸에서만 돈다. 없으면 일이 "대기"에 머문다)
#       COMPOSE_FILE=docker-compose.prod.yml:docker-compose.code.yml
#       (나머지는 B와 같다. 칸 하나가 메모리를 최대 4GB까지 쓴다)
#
# [D] 서버: C + 서버 브라우저 (README 6장: Caddy의 /browser/ 규칙, 방화벽 UDP 52000도 해야 한다)
#       COMPOSE_FILE=docker-compose.prod.yml:docker-compose.code.yml:docker-compose.browser.yml
#       CAIRN_BROWSER_PASSWORD=<긴 임의 값>
#       CAIRN_PUBLIC_IP=<서버의 공인 IP>
#       (나머지는 B와 같다. 브라우저가 메모리를 0.3~1GB 더 쓴다)
#
# 서버의 3000 · 4000 포트를 이미 다른 프로그램이 쓰면 WEB_PORT · SERVER_PORT를 바꾸고, 앞단 프록시도 그 포트로 넘긴다
# 앞단 프록시가 Docker 컨테이너면 docker-compose.override.yml로 그 네트워크에 붙이고 COMPOSE_FILE 끝에 :docker-compose.override.yml (README 2장)
# ──────────────────────────────────────────────────────────────────────────────────

# 쓸 compose 파일들. 비워 두면 개발 구성(docker-compose.yml). 서버는 위 B · C · D 중 하나
# COMPOSE_FILE=docker-compose.prod.yml
# 파일 여럿을 :로 잇는다. Windows는 기본 구분자가 ;라서 이 줄이 있어야 :가 먹는다 (Linux · Mac에서도 그대로 둬도 된다)
COMPOSE_PATH_SEPARATOR=:

# DB 비밀번호. 서버에 올릴 때는 긴 임의 값으로 (DB를 처음 만들 때 정해져서 나중에 바꾸면 맞지 않아요)
DB_PASSWORD=cairn
DB_PORT=5432

# 서버(API)와 웹 포트. DB · 서버 · 웹 모두 이 컴퓨터(127.0.0.1)에서만 열린다 (밖에는 https 프록시만)
SERVER_PORT=4000
WEB_PORT=3000

# 서버 키: 비밀값(플러그인 토큰 등)을 DB에 암호화해 넣을 때 쓴다. 설치 때 한 번 만든다
#   만들기: pnpm secret:new  (node가 없으면 openssl rand -base64 32)
#   잃어버리면 저장된 비밀값을 다시 넣어야 해요. DB 백업과 함께 따로 보관한다
CAIRN_SECRET_KEY=

# 사람이 여는 웹 주소. 서버에 올렸으면 꼭 https://내블로그주소
#   설치 코드 안내 · 푸시 연락처에 쓰고, 개발 모드 웹은 이 주소에서 연 화면만 동작하게 한다 (다르면 버튼이 눌리지 않아요)
#   비워 두면 http://localhost:<WEB_PORT>
# CAIRN_WEB_URL=

# ── 서버 브라우저 (위 D, 또는 A의 브라우저) ─────────────────────────────────────────────
# 화면에 들어갈 때 묻는 비밀번호 (배포 서버에서는 Caddy의 주인 확인과 두 겹)
# CAIRN_BROWSER_PASSWORD=
# 화면 영상(UDP 52000)이 밖에서 닿을 서버의 공인 IP. 내 컴퓨터면 127.0.0.1
# CAIRN_PUBLIC_IP=
# 화면 페이지 포트 (이 서버 안에서만 열린다. Caddy가 /browser/로 넘긴다)
# BROWSER_VIEW_PORT=4100
# 화면 영상(UDP 52000)을 열 주소. 비우면 모든 주소에 열린다 (Docker가 연 포트는 ufw를 거치지 않는다)
#   인터넷에 열지 않으려면 Tailscale을 깔고 서버의 Tailscale 주소를 이것과 CAIRN_PUBLIC_IP 둘 다에 넣는다
#   (그러면 Tailscale로 붙은 내 기기에서만 영상이 온다). 아니면 클라우드 보안 그룹에서 내 IP만 허용한다
# BROWSER_UDP_BIND=100.x.x.x
# ARM 컴퓨터(Snapdragon 노트북, Apple 실리콘 등)에서만: 기본 이미지는 amd64뿐이라 "no match for platform"으로 빌드가 멈춘다.
#   amd64 · arm64가 함께 있는 neko 3.2.0 (시험한 판보다 새 판이라 정책 · CDP가 그대로 먹는지 직접 확인할 것)
# CAIRN_NEKO_IMAGE=ghcr.io/m1k1o/neko/chromium@sha256:270face8b8111e639744fb7bcdbbf0deed227900bb89d58b2f8adfc12af8c41e

# ── 결과물 한도 ────────────────────────────────────────────────────────────────────
# AI가 작업에서 만든 파일의 한도. 공간 전체 GB, 디스크에 늘 남길 GB (DB가 디스크가 차서 멈추지 않게)
#   서버 기본은 80 · 20 (디스크 200GB 기준), 개발 구성은 80 · 5. 모자라면 늘리거나, 나중에 클라우드 저장소로 옮긴다
# CAIRN_OUTPUTS_MAX_GB=80
# CAIRN_DISK_RESERVE_GB=20

# ── 가끔만 쓰는 것 ──────────────────────────────────────────────────────────────────
# 서버 키를 바꿀 때만. 순서:
#   1. 지금 키를 CAIRN_SECRET_KEY_OLD로 옮기고, CAIRN_SECRET_KEY에 새 키를 넣는다
#   2. docker compose up -d   (서버 · 일꾼이 새 키로 쓰고, 옛 키로 잠긴 값도 읽는다)
#   3. pnpm secret:rotate     (node가 없으면 docker compose exec -T server cairn-admin secret rotate)
#      저장된 비밀값을 새 키로 다시 암호화한다. 두 번 돌려도 안전하고, 풀리지 않는 값이 있으면 멈춘다
#   4. CAIRN_SECRET_KEY_OLD를 지우고 docker compose up -d
#   키를 바꾸면 설치 코드가 바뀌고, 진행 중인 기기 승인 · 설치 · 외부 로그인은 처음부터 다시 해야 해요.
#   브라우저 푸시도 콘솔의 알림 메뉴에서 브라우저마다 "다시 켜기"를 눌러야 해요
# CAIRN_SECRET_KEY_OLD=

# 브라우저 푸시: 따로 할 일 없음. 서버 키에서 키를 만들고, 알려진 푸시 서비스(크롬 · 파이어폭스 · 사파리 · 엣지)로만 보낸다
#   직접 운영하는 푸시 서비스가 있을 때만 그 출처를 쉼표로
# CAIRN_PUSH_EXTRA_ORIGINS=https://push.example.com

# 서버 러너: 서버와 함께 뜨고 스스로 연결한다 (할 일 없음). 콘솔의 AI 메뉴에 토큰을 넣으면 일한다
#   예전처럼 기기 토큰을 직접 줄 때만
# CAIRN_RUNNER_TOKEN=
# 실행 기록에 남는 러너 빌드 이름 (빌드할 때 git rev-parse --short HEAD)
# CAIRN_RUNNER_BUILD=
# 내 컴퓨터에서 러너를 돌리는 법은 apps/runner/.env.example
