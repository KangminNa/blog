{
  "name": "code-github",
  "version": "0.1.0",
  "cairn": ">=0.3",
  "description": "코드 작업을 GitHub와 잇는다: 저장소를 등록하고 일을 맡기면 코드 러너 칸이 고쳐 draft PR을 열고, 주인이 머지한 뒤 승인하면 끝난다",
  "schema": "code_github",
  "server": "server/plugin.ts",
  "settings": {
    "token": {
      "label": "GitHub 토큰",
      "type": "secret",
      "required": true,
      "help": "Fine-grained token. 등록할 저장소들만 고르고 Contents · Pull requests 쓰기만 (Workflows는 주지 않아요)"
    },
    "apiUrl": {
      "label": "GitHub API 주소",
      "type": "text",
      "default": "https://api.github.com",
      "help": "GitHub Enterprise를 쓸 때만 바꿔요"
    }
  },
  "api": {
    "GET /repos": "listRepos",
    "POST /repos": "createRepo",
    "PATCH /repos/:id": "updateRepo",
    "POST /repos/:id/archive": "archiveRepo",
    "POST /repos/:id/tasks": "requestCode",
    "GET /pulls": "listPulls",
    "GET /pulls/:id": "pull"
  },
  "tools": {
    "code_credential": {
      "operation": "credential",
      "description": "코드 러너 칸이 빌린 code 작업의 저장소 토큰과, 이미 연 PR(고쳐 달라로 다시 온 일)을 받는다. 그 작업의 임대를 쥔 칸만. 토큰은 메모리에만 두고 AI에게 주지 않는다.",
      "input": {
        "properties": {
          "task_id": { "type": "string", "format": "uuid", "description": "빌린 code 작업 id" }
        },
        "required": ["task_id"]
      }
    },
    "code_pull_opened": {
      "operation": "pullOpened",
      "description": "러너가 연(또는 고친) PR을 남긴다. 같은 작업이면 한 줄을 고치고, head가 바뀌면 판(version)이 오른다. 받은 pull_id · version으로 request_approval(code.pr.merge)을 올린다.",
      "input": {
        "properties": {
          "task_id": { "type": "string", "format": "uuid", "description": "빌린 code 작업 id" },
          "number": { "type": "integer", "minimum": 1, "description": "PR 번호" },
          "url": { "type": "string", "maxLength": 500, "description": "PR 주소" },
          "branch": { "type": "string", "maxLength": 60, "description": "cairn/<작업>" },
          "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "올린 커밋" },
          "checks": {
            "type": "array",
            "maxItems": 10,
            "description": "검사 결과",
            "items": {
              "type": "object",
              "properties": {
                "command": { "type": "string", "maxLength": 500 },
                "ok": { "type": "boolean" }
              },
              "required": ["command", "ok"]
            }
          }
        },
        "required": ["task_id", "number", "url", "branch", "head_sha", "checks"]
      }
    }
  },
  "menu": {
    "group": "운영",
    "name": "코드",
    "icon": "code",
    "page": "web/CodePage.tsx"
  },
  "uses": [
    "table",
    "api",
    "tool:code_credential",
    "tool:code_pull_opened",
    "menu",
    "task:request",
    "event:task.approval.granted"
  ]
}
